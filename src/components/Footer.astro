---
import { Moon, Sun } from "@lucide/astro";
import { common, footerLinks, langCodes, pathFor, switchPath, tx, type Lang } from "@data/site";

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/images/brand/logo-goldbear.webp" alt="SleepM" width="150" height="66" loading="lazy" />
      <p>{tx(lang, common.footer.nightKept)}</p>
    </div>

    <div class="footer-col">
      <h2>{tx(lang, common.footer.appTitle)}</h2>
      <img class="qr" src="/images/app/qr.jpg" alt="Sleepm app QR code" width="120" height="120" loading="lazy" />
      <p>{tx(lang, common.footer.appText)}</p>
    </div>

    <div class="footer-col">
      <h2>{tx(lang, common.footer.legalTitle)}</h2>
      <div class="footer-links">
        {footerLinks.map((link) => <a href={pathFor(lang, link.path)}>{tx(lang, link.label)}</a>)}
      </div>
    </div>

    <div class="footer-col">
      <h2>{tx(lang, common.labels.language)}</h2>
      <div class="footer-lang">
        {langCodes.map((code) => (
          <a class:list={[code === lang && "is-active"]} href={switchPath(pathname, code)}>{code.toUpperCase()}</a>
        ))}
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
        <Moon class="moon" size={18} aria-hidden="true" />
        <Sun class="sun" size={18} aria-hidden="true" />
        <span>{tx(lang, common.labels.theme)}</span>
      </button>
    </div>
  </div>
  <p class="legal">{tx(lang, common.footer.disclaimer)} &copy; 2026 SleepM.</p>
</footer>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;
    const paint = () => {
      const light = document.documentElement.dataset.theme === "light";
      button.setAttribute("aria-pressed", String(light));
    };
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "night" : "light";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("sleepm-theme", next);
      } catch (_) {}
      paint();
    });
    paint();
  })();
</script>
