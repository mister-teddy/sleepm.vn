---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  accent?: string;
  align?: "center" | "left";
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, text, accent = "", align = "center", image, imageAlt = "" } = Astro.props;
const parts = accent && title.includes(accent) ? title.split(accent) : null;
---

<section class:list={["hero", align === "left" && "hero-left", image && "hero-with-image"]}>
  <div class="hero-copy awaken">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {parts ? <>{parts[0]}<em>{accent}</em>{parts.slice(1).join(accent)}</> : title}
    </h1>
    <p class="hero-text">{text}</p>
    <slot />
  </div>
  {image && (
    <figure class="hero-media awaken">
      <img src={image} alt={imageAlt} loading="eager" />
    </figure>
  )}
</section>
