---
export function getStaticPaths() {
  const targets = [
    "products",
    "products/mattress",
    "products/topper",
    "products/pillows",
    "products/heating-pad",
    "products/eye-mask",
    "products/knee-massager",
    "products/light",
    "products/dot",
    "products/app",
    "crystals",
    "crystal-journey",
    "constellation",
    "night-wire",
    "family",
    "distributors",
    "become-a-distributor",
    "sign-in",
    "contact",
  ];

  return targets.map((path) => ({
    params: { path },
    props: { target: "/" },
  }));
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirect - SleepM</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>SleepM Vietnamese information site</a>.</p>
  </body>
</html>
