---
import { Mail, MapPin, Phone, Send, Sparkles } from "@lucide/astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, offices, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.contact)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Let's connect", vi: "Kết nối với Sleepm" })}
    title={tx(lang, { en: "We would love to hear from you.", vi: "Chúng tôi rất muốn nghe từ bạn." })}
    accent={tx(lang, { en: "hear", vi: "nghe" })}
    text={tx(lang, { en: "Questions, suggestions or a good sleep story - the family answers in your language.", vi: "Câu hỏi, góp ý hoặc một câu chuyện ngủ ngon - gia đình Sleepm sẽ trả lời bằng ngôn ngữ của bạn." })}
  />

  <section class="section split align-start">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Viết cho chúng tôi" : "Write to us"}</p>
      <h2>{lang === "vi" ? <>Gửi một <em>lời nhắn</em>.</> : <>Send a <em>note</em>.</>}</h2>
      <p>{lang === "vi" ? "Hãy cho chúng tôi biết bạn đang tìm kiếm sản phẩm, hỗ trợ hay cơ hội chia sẻ Sleepm. Một thành viên trong gia đình sẽ phản hồi sớm." : "Tell us whether you are looking for product guidance, support or a way to share Sleepm. A member of the family will answer soon."}</p>
      <p><Mail size={16} aria-hidden="true" /> info@sleepm.com · support@sleepm.com</p>
      <p><Phone size={16} aria-hidden="true" /> English: +1 905-604-5558 · Tiếng Việt: contact your distributor</p>
    </div>

    <form class="card form-grid awaken" action="mailto:info@sleepm.com" method="post" enctype="text/plain" data-contact-form>
      <div class="form-grid two">
        <label>
          {lang === "vi" ? "Tên" : "First name"}
          <input name="first_name" autocomplete="given-name" required />
        </label>
        <label>
          {lang === "vi" ? "Họ" : "Last name"}
          <input name="last_name" autocomplete="family-name" required />
        </label>
      </div>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        {lang === "vi" ? "Số điện thoại" : "Phone"}
        <input name="phone" type="tel" autocomplete="tel" required />
      </label>
      <label>
        {lang === "vi" ? "Bạn biết Sleepm từ đâu?" : "How did you hear about us?"}
        <select name="source" required>
          <option value="">{lang === "vi" ? "Chọn một lựa chọn" : "Choose one"}</option>
          <option>{lang === "vi" ? "Tìm kiếm trực tuyến" : "Online browsing"}</option>
          <option>{lang === "vi" ? "Buổi giới thiệu" : "Presentation"}</option>
          <option>{lang === "vi" ? "Được giới thiệu" : "Recommended by someone"}</option>
          <option>{lang === "vi" ? "Nhà phân phối" : "Distributor"}</option>
        </select>
      </label>
      <label>
        {lang === "vi" ? "Lý do bạn liên hệ" : "Why are you reaching out?"}
        <textarea name="message" required></textarea>
      </label>
      <button class="btn" type="submit">
        <Send size={16} aria-hidden="true" />
        {tx(lang, common.labels.send)}
      </button>
      <p class="form-note" data-form-note></p>
    </form>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Văn phòng" : "Our offices"}</p>
      <h2>{lang === "vi" ? <>Nơi gia đình giữ ánh đèn <em>dịu</em>.</> : <>Where the family keeps the lights <em>low</em>.</>}</h2>
    </div>
    <div class="office-grid">
      {offices.map((office) => (
        <article class="office awaken">
          <span class="meta">{tx(lang, office.region)}</span>
          <h3>{office.city}</h3>
          <p><MapPin size={16} aria-hidden="true" /> {office.address.join(", ")}</p>
          <p><Phone size={16} aria-hidden="true" /> {office.phone}</p>
          <p><Mail size={16} aria-hidden="true" /> {office.email}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Đi sâu hơn" : "Or go deeper"}</p>
      <h2>{lang === "vi" ? <>Gia nhập <em>gia đình</em>.</> : <>Join the <em>family</em>.</>}</h2>
      <p>{lang === "vi" ? "Chia sẻ Sleepm trong cộng đồng của bạn, bằng ngôn ngữ của bạn." : "Share Sleepm in your community, in your language, with the family behind you."}</p>
      <a class="btn" href={pathFor(lang, "/distributors/")}>
        <Sparkles size={16} aria-hidden="true" />
        {tx(lang, common.labels.becomeDistributor)}
      </a>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-contact-form]");
    const note = document.querySelector("[data-form-note]");
    if (!form || !note) return;
    form.addEventListener("submit", () => {
      note.textContent = document.documentElement.lang.startsWith("vi")
        ? "Ứng dụng email của bạn sẽ mở để gửi lời nhắn."
        : "Your email app will open to send this note.";
    });
  })();
</script>
