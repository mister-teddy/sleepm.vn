---
import { Mail, MapPin, Phone, Send, Users } from "@lucide/astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, offices, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.contact)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Contact Sleepm", vi: "Liên hệ Sleepm" })}
    title={tx(lang, { en: "Product questions, support and distributor inquiries.", vi: "Tư vấn sản phẩm, hỗ trợ và nhà phân phối." })}
    accent={tx(lang, { en: "support", vi: "hỗ trợ" })}
    text={tx(lang, { en: "Use the form or official office contacts for mattress, topper, pillow, warranty, app and distributor questions.", vi: "Dùng biểu mẫu hoặc thông tin văn phòng chính thức để hỏi về nệm, topper, gối, bảo hành, app và cơ hội nhà phân phối." })}
  />

  <section class="section split align-start">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Gửi yêu cầu" : "Send an inquiry"}</p>
      <h2>{lang === "vi" ? <>Để lại thông tin <em>liên hệ</em>.</> : <>Leave your <em>contact</em> details.</>}</h2>
      <p>{lang === "vi" ? "Hãy cho biết bạn cần tư vấn sản phẩm, kiểm tra bảo hành, hỗ trợ ứng dụng hay tìm hiểu cơ hội nhà phân phối." : "Tell us whether you need product guidance, warranty support, app support or distributor information."}</p>
      <p><Mail size={16} aria-hidden="true" /> info@sleepm.com · support@sleepm.com</p>
      <p><Phone size={16} aria-hidden="true" /> English: +1 905-604-5558 · Español: +1 905-454-5705 · 中文: +1 647-545-8555</p>
      <p><MapPin size={16} aria-hidden="true" /> {lang === "vi" ? "Việt Nam: Phòng 903, tầng 9, số 34 Lê Duẩn, P. Sài Gòn, TP. Hồ Chí Minh" : "Vietnam: Room 903, 9th Floor, No. 34 Le Duan Street, Sai Gon Ward, Ho Chi Minh City"}</p>
    </div>

    <form class="card form-grid awaken" action="mailto:info@sleepm.com" method="post" enctype="text/plain" data-contact-form>
      <div class="form-grid two">
        <label>
          {lang === "vi" ? "Tên" : "First name"}
          <input name="first_name" autocomplete="given-name" required />
        </label>
        <label>
          {lang === "vi" ? "Họ" : "Last name"}
          <input name="last_name" autocomplete="family-name" required />
        </label>
      </div>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        {lang === "vi" ? "Số điện thoại" : "Phone"}
        <input name="phone" type="tel" autocomplete="tel" required />
      </label>
      <label>
        {lang === "vi" ? "Bạn liên hệ về nội dung nào?" : "What is this about?"}
        <select name="source" required>
          <option value="">{lang === "vi" ? "Chọn một lựa chọn" : "Choose one"}</option>
          <option>{lang === "vi" ? "Tư vấn nệm / topper / gối" : "Mattress / topper / pillow guidance"}</option>
          <option>{lang === "vi" ? "Bảo hành hoặc hỗ trợ sản phẩm" : "Warranty or product support"}</option>
          <option>{lang === "vi" ? "Ứng dụng Sleepm" : "Sleepm app"}</option>
          <option>{lang === "vi" ? "Trở thành nhà phân phối" : "Become a distributor"}</option>
        </select>
      </label>
      <label>
        {lang === "vi" ? "Sleepm ID hoặc người giới thiệu (nếu có)" : "Sleepm ID or referring distributor (optional)"}
        <input name="sleepm_id" autocomplete="off" />
      </label>
      <label>
        {lang === "vi" ? "Lý do bạn liên hệ" : "Why are you reaching out?"}
        <textarea name="message" required></textarea>
      </label>
      <button class="btn" type="submit">
        <Send size={16} aria-hidden="true" />
        {tx(lang, common.labels.send)}
      </button>
      <p class="form-note" data-form-note></p>
    </form>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Văn phòng" : "Our offices"}</p>
      <h2>{lang === "vi" ? <>Thông tin liên hệ <em>theo khu vực</em>.</> : <>Regional <em>contact</em> information.</>}</h2>
    </div>
    <div class="office-grid">
      {offices.map((office) => (
        <article class="office awaken">
          <span class="meta">{tx(lang, office.region)}</span>
          <h3>{office.city}</h3>
          <p><MapPin size={16} aria-hidden="true" /> {office.address.join(", ")}</p>
          {office.phone && <p><Phone size={16} aria-hidden="true" /> {office.phone}</p>}
          {office.email && <p><Mail size={16} aria-hidden="true" /> {office.email}</p>}
          {"note" in office && <p>{tx(lang, office.note)}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Cơ hội kinh doanh" : "Business opportunity"}</p>
      <h2>{lang === "vi" ? <>Tìm hiểu mô hình <em>nhà phân phối</em>.</> : <>Learn about the <em>distributor</em> model.</>}</h2>
      <p>{lang === "vi" ? "Trao đổi với Sleepm để biết điều kiện, thị trường hỗ trợ và quy trình bắt đầu." : "Contact Sleepm for requirements, supported markets and next steps."}</p>
      <a class="btn" href={pathFor(lang, "/distributors/")}>
        <Users size={16} aria-hidden="true" />
        {tx(lang, common.labels.becomeDistributor)}
      </a>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-contact-form]");
    const note = document.querySelector("[data-form-note]");
    if (!form || !note) return;
    form.addEventListener("submit", () => {
      note.textContent = document.documentElement.lang.startsWith("vi")
        ? "Ứng dụng email của bạn sẽ mở để gửi lời nhắn."
        : "Your email app will open to send this note.";
    });
  })();
</script>
