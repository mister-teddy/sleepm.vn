---
import { Gem } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { crystalIntro, crystals, langCodes, metals, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, crystalIntro.eyebrow)} description={tx(lang, crystalIntro.text)}>
  <LocalizedHero
    eyebrow={tx(lang, crystalIntro.eyebrow)}
    title={tx(lang, crystalIntro.title)}
    accent={lang === "vi" ? "BioCrystal" : "BioCrystal"}
    text={tx(lang, crystalIntro.text)}
  >
    <div class="actions">
      <a class="btn" href="#journey">
        <Gem size={16} aria-hidden="true" />
        {lang === "vi" ? "Xem 16 tinh thể" : "View 16 crystals"}
      </a>
    </div>
  </LocalizedHero>

  <section id="journey" class="section section-wide">
    <div class="crystal-grid">
      {crystals.map((crystal, index) => (
        <article class="crystal-card awaken">
          <figure>
            <img src={crystal.img} alt={tx(lang, crystal.name)} loading="lazy" />
          </figure>
          <div class="crystal-body">
            <span class="meta">{String(index + 1).padStart(2, "0")} / 16 · {tx(lang, crystal.role)}</span>
            <h3>{tx(lang, crystal.name)}</h3>
            <p>{tx(lang, crystal.lore)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Và hai kim loại quý" : "And two noble metals"}</p>
      <h2>{lang === "vi" ? <>Vàng và bạc trong <em>hỗn hợp BioCrystal</em>.</> : <>Gold and silver in the <em>BioCrystal blend</em>.</>}</h2>
      <p>{lang === "vi" ? "Sleepm trình bày vàng và bạc như hai kim loại quý hoàn thiện câu chuyện thành phần BioCrystal trong dòng sản phẩm của mình." : "Sleepm presents gold and silver as the two noble metals that complete the BioCrystal ingredient story across the product line."}</p>
    </div>
    <div class="card-grid">
      {metals.map((metal) => (
        <article class="crystal-card awaken">
          <figure>
            <img src={metal.img} alt={tx(lang, metal.name)} loading="lazy" />
          </figure>
          <div class="crystal-body">
            <span class="meta">{lang === "vi" ? "Kim loại quý" : "Noble metal"}</span>
            <h3>{tx(lang, metal.name)}</h3>
            <p>{tx(lang, metal.lore)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
