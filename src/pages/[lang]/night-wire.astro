---
import { ExternalLink, Mail } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, wireItems, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.nightWire)}>
  <LocalizedHero
    eyebrow={tx(lang, common.nav.nightWire)}
    title={tx(lang, { en: "SleepM news, product resources and support links.", vi: "Tin tức, tài nguyên sản phẩm và hỗ trợ SleepM." })}
    accent={tx(lang, { en: "resources", vi: "tài nguyên" })}
    text={tx(lang, { en: "A practical index for product information, sleep health education, warranty steps and contact details.", vi: "Mục lục thực dụng cho thông tin sản phẩm, kiến thức giấc ngủ, bước bảo hành và liên hệ." })}
  >
    <div class="actions">
      <a class="btn" href="mailto:info@sleepm.com?subject=SleepM%20information%20request">
        <Mail size={16} aria-hidden="true" />
        {tx(lang, { en: "Ask SleepM by email", vi: "Gửi email cho SleepM" })}
      </a>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.nav.contact)}</a>
    </div>
  </LocalizedHero>

  <section class="section section-wide">
    <div class="wire-grid">
      {wireItems.map((item) => (
        <a class="wire-card awaken" href={item.url} target="_blank" rel="noopener noreferrer">
          <span class="source">{item.source}</span>
          <h3>{tx(lang, item.title)}</h3>
          <p>{tx(lang, item.note)}</p>
          <span class="text-link">{tx(lang, { en: "Open source", vi: "Mở nguồn" })} <ExternalLink size={14} aria-hidden="true" /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Gợi ý tiếp theo" : "Next steps"}</p>
      <h2>{lang === "vi" ? <>Từ tìm hiểu đến <em>kênh chính thức</em>.</> : <>From research to <em>official channels</em>.</>}</h2>
      <p>{lang === "vi" ? "Sau khi xem thông tin sản phẩm, hãy dùng trang liên hệ hoặc sleepm.com để hỏi thông tin chính thức. sleepm.vn không hiển thị giá, không xác nhận đơn hàng và không xử lý thanh toán." : "After reviewing product information, use the contact page or sleepm.com for official information. sleepm.vn does not show prices, confirm orders or process payments."}</p>
    </div>
    <div class="card-grid">
      {[
        { title: { en: "Product information", vi: "Thông tin sản phẩm" }, place: lang === "vi" ? "Nệm / topper / gối" : "Mattress / topper / pillows" },
        { title: { en: "Warranty channel", vi: "Kênh bảo hành" }, place: lang === "vi" ? "Ảnh, số đo, thông tin sản phẩm" : "Photos, measurements, product details" },
        { title: { en: "Legal and contact role", vi: "Vai trò pháp lý và liên hệ" }, place: lang === "vi" ? "sleepm.vn / SleepM Global Inc." : "sleepm.vn / SleepM Global Inc." },
      ].map((post) => (
        <article class="card awaken">
          <span class="meta">{post.place}</span>
          <h3>{tx(lang, post.title)}</h3>
          <p>{lang === "vi" ? "Dùng trang liên hệ để gửi yêu cầu thông tin tới SleepM." : "Use the contact page to send an information request to SleepM."}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
