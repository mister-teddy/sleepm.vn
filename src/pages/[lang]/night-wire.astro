---
import { ExternalLink, Mail } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, wireItems, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.nightWire)}>
  <LocalizedHero
    eyebrow={tx(lang, common.nav.nightWire)}
    title={tx(lang, { en: "Tonight's dispatches.", vi: "Những bản tin của đêm nay." })}
    accent={tx(lang, { en: "Tonight", vi: "đêm nay" })}
    text={tx(lang, { en: "Sleep science, sleep tech and word from the family - curated while you were dreaming.", vi: "Khoa học giấc ngủ, công nghệ ngủ và tin từ cộng đồng - được tuyển chọn khi bạn đang mơ." })}
  >
    <div class="actions">
      <a class="btn" href="mailto:info@sleepm.com?subject=Sleepm%20Night%20Wire">
        <Mail size={16} aria-hidden="true" />
        {tx(lang, { en: "Get the Wire by email", vi: "Nhận bản tin qua email" })}
      </a>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.nav.contact)}</a>
    </div>
  </LocalizedHero>

  <section class="section section-wide">
    <div class="wire-grid">
      {wireItems.map((item) => (
        <a class="wire-card awaken" href={item.url} target="_blank" rel="noopener noreferrer">
          <span class="source">{item.source}</span>
          <h3>{tx(lang, item.title)}</h3>
          <p>{tx(lang, item.note)}</p>
          <span class="text-link">{tx(lang, { en: "Open source", vi: "Mở nguồn" })} <ExternalLink size={14} aria-hidden="true" /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Từ gia đình" : "From the family"}</p>
      <h2>{lang === "vi" ? <>Vòng tròn <em>lên tiếng</em>.</> : <>The circle <em>speaks</em>.</>}</h2>
      <p>{lang === "vi" ? "Những câu chuyện đã được chào đón từ thành viên Sleepm có thể xuất hiện tại đây sau khi đội ngũ biên tập xem xét." : "Welcomed stories from Sleepm members can appear here after the night desk reviews them."}</p>
    </div>
    <div class="card-grid">
      {[
        { title: { en: "A distributor rose to Star Four", vi: "Một nhà phân phối lên bốn sao" }, place: "Toronto" },
        { title: { en: "New topper inquiry", vi: "Yêu cầu tư vấn topper mới" }, place: "Vancouver" },
        { title: { en: "Heating pad warmed a home", vi: "Đệm sưởi làm ấm một mái nhà" }, place: "Las Vegas" },
      ].map((post) => (
        <article class="card awaken">
          <span class="meta">Live · {post.place}</span>
          <h3>{tx(lang, post.title)}</h3>
          <p>{lang === "vi" ? "Một nhịp nhỏ trong cộng đồng Sleepm." : "A small pulse from the Sleepm family."}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
