---
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { crystals, langCodes, metals, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const items = [...crystals, ...metals];
const coords = [
  [120, 225], [225, 165], [330, 260], [445, 210], [560, 310], [690, 250],
  [810, 345], [930, 280], [1040, 390], [1160, 300], [1260, 205], [1375, 290],
  [1270, 430], [1110, 500], [940, 455], [760, 520], [570, 455], [380, 505],
];
const points = items.map((item, index) => ({ item, x: coords[index][0], y: coords[index][1] }));
---

<SiteLayout lang={lang} title={tx(lang, { en: "Ingredients", vi: "Thành phần" })}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "BioCrystal ingredient map", vi: "Sơ đồ thành phần BioCrystal" })}
    title={tx(lang, { en: "Eighteen listed ingredients in the BioCrystal story.", vi: "Mười tám thành phần trong câu chuyện BioCrystal." })}
    accent={tx(lang, { en: "Eighteen", vi: "Mười tám" })}
    text={tx(lang, { en: "A simple visual reference for the 16 natural crystals plus gold and silver used in SleepM's BioCrystal blend.", vi: "Sơ đồ tham khảo cho 16 tinh thể tự nhiên cùng vàng và bạc trong hỗn hợp BioCrystal của SleepM." })}
  />

  <section class="section section-wide">
    <div class="constellation awaken" aria-label={tx(lang, { en: "SleepM BioCrystal ingredient map", vi: "Sơ đồ thành phần BioCrystal SleepM" })}>
      <svg viewBox="0 100 1500 520" role="img">
        {points.slice(0, -1).map((point, index) => (
          <line x1={point.x} y1={point.y} x2={points[index + 1].x} y2={points[index + 1].y}></line>
        ))}
        {points.map(({ item, x, y }, index) => (
          <g>
            <circle cx={x} cy={y} r={index > 15 ? 7 : 5}></circle>
            <text x={x + 15} y={y - 12}>{tx(lang, item.name)}</text>
          </g>
        ))}
      </svg>
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Trong dòng sản phẩm" : "Across the product line"}</p>
      <h2>{lang === "vi" ? <>BioCrystal là <em>điểm nhận diện</em> của SleepM.</> : <>BioCrystal is SleepM's <em>signature</em> feature.</>}</h2>
      <p>{lang === "vi" ? "Nội dung này giúp người đọc hiểu rõ thành phần BioCrystal như thông tin thương hiệu và truyền thống, không biến nó thành cam kết y tế." : "This page helps readers understand the BioCrystal ingredient story as brand and heritage information, not as a medical claim."}</p>
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
