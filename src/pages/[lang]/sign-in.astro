---
import { LogIn, ShieldCheck } from "@lucide/astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.signIn)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Member portal", vi: "Cổng thành viên" })}
    title={tx(lang, { en: "The night desk is almost ready.", vi: "Bàn hỗ trợ đêm sắp sẵn sàng." })}
    accent={tx(lang, { en: "night desk", vi: "Bàn hỗ trợ đêm" })}
    text={tx(lang, { en: "Member access is reserved for distributors and the Sleepm family. Contact support if you need help with your invitation.", vi: "Quyền truy cập dành cho nhà phân phối và gia đình Sleepm. Liên hệ hỗ trợ nếu bạn cần trợ giúp với lời mời của mình." })}
  />

  <section class="section split">
    <form class="card form-grid awaken">
      <label>
        Email
        <input type="email" autocomplete="email" placeholder="member@sleepm.com" />
      </label>
      <label>
        {lang === "vi" ? "Mật khẩu" : "Password"}
        <input type="password" autocomplete="current-password" />
      </label>
      <button class="btn" type="button">
        <LogIn size={16} aria-hidden="true" />
        {tx(lang, common.nav.signIn)}
      </button>
      <p class="form-note">{lang === "vi" ? "Liên hệ hỗ trợ để kích hoạt quyền truy cập thành viên." : "Contact support to activate member access."}</p>
    </form>
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Điều gì sẽ ở đây" : "What lives here"}</p>
      <h2>{lang === "vi" ? <>Tài nguyên cho <em>gia đình</em>.</> : <>Resources for the <em>family</em>.</>}</h2>
      <div class="feature-grid">
        <article class="feature">
          <ShieldCheck size={24} aria-hidden="true" />
          <h3>{lang === "vi" ? "Hồ sơ thành viên" : "Member profiles"}</h3>
          <p>{lang === "vi" ? "Thông tin nhà phân phối và trạng thái cộng đồng." : "Distributor details and community status."}</p>
        </article>
        <article class="feature">
          <ShieldCheck size={24} aria-hidden="true" />
          <h3>{lang === "vi" ? "Tài liệu sản phẩm" : "Product resources"}</h3>
          <p>{lang === "vi" ? "Câu chuyện, hình ảnh và tài liệu hỗ trợ chia sẻ." : "Stories, media and support material for sharing."}</p>
        </article>
      </div>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.nav.contact)}</a>
    </div>
  </section>
</SiteLayout>
