---
import { ExternalLink, ShieldCheck } from "@lucide/astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.signIn)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Global SleepM website", vi: "Website toàn cầu SleepM" })}
    title={tx(lang, { en: "Use sleepm.com for official global resources.", vi: "Dùng sleepm.com cho tài nguyên toàn cầu chính thức." })}
    accent={tx(lang, { en: "global", vi: "toàn cầu" })}
    text={tx(lang, { en: "sleepm.vn is a public Vietnamese information website. It does not host a local Vietnam member portal, order dashboard or checkout area.", vi: "sleepm.vn là website thông tin tiếng Việt công khai. Website không vận hành cổng thành viên, trang đơn hàng hoặc khu vực thanh toán nội địa tại Việt Nam." })}
  >
    <div class="actions">
      <a class="btn" href="https://sleepm.com/" target="_blank" rel="noopener">
        <ExternalLink size={16} aria-hidden="true" />
        sleepm.com
      </a>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.nav.contact)}</a>
    </div>
  </LocalizedHero>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Lưu ý" : "Note"}</p>
      <h2>{lang === "vi" ? <>Không có <em>đăng nhập nội địa</em> trên sleepm.vn.</> : <>No local <em>member login</em> on sleepm.vn.</>}</h2>
      <p>
        {lang === "vi"
          ? "Nếu bạn cần thông tin về tài khoản, bảo hành, hỗ trợ sản phẩm hoặc tài nguyên chính thức, hãy dùng kênh toàn cầu của SleepM hoặc gửi yêu cầu qua trang liên hệ."
          : "If you need account, warranty, product support or official resource information, use SleepM global channels or send an inquiry through the contact page."}
      </p>
    </div>
    <div class="feature-grid awaken">
      <article class="feature">
        <ShieldCheck size={24} aria-hidden="true" />
        <h3>{lang === "vi" ? "Không xử lý đơn hàng" : "No order handling"}</h3>
        <p>{lang === "vi" ? "sleepm.vn không có hồ sơ đơn hàng, giỏ hàng hoặc xác nhận giao dịch." : "sleepm.vn has no order profile, cart or transaction confirmation flow."}</p>
      </article>
      <article class="feature">
        <ShieldCheck size={24} aria-hidden="true" />
        <h3>{lang === "vi" ? "Kênh chính thức" : "Official channels"}</h3>
        <p>{lang === "vi" ? "Thông tin chính thức về SleepM được ưu tiên dẫn về sleepm.com và email hỗ trợ toàn cầu." : "Official SleepM information is directed to sleepm.com and global support emails."}</p>
      </article>
    </div>
  </section>
</SiteLayout>
