---
import { LogIn, ShieldCheck } from "@lucide/astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.signIn)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Member portal", vi: "Cổng thành viên" })}
    title={tx(lang, { en: "Distributor and customer member access.", vi: "Đăng nhập thành viên và nhà phân phối." })}
    accent={tx(lang, { en: "member", vi: "thành viên" })}
    text={tx(lang, { en: "This static site mirrors the public Sleepm website. Use official Sleepm member credentials or contact support if access has not been activated.", vi: "Website tĩnh này mô phỏng phần công khai của Sleepm. Dùng tài khoản thành viên chính thức hoặc liên hệ hỗ trợ nếu quyền truy cập chưa được kích hoạt." })}
  />

  <section class="section split">
    <form class="card form-grid awaken">
      <label>
        Email
        <input type="email" autocomplete="email" placeholder="member@sleepm.com" />
      </label>
      <label>
        {lang === "vi" ? "Mật khẩu" : "Password"}
        <input type="password" autocomplete="current-password" />
      </label>
      <button class="btn" type="button">
        <LogIn size={16} aria-hidden="true" />
        {tx(lang, common.nav.signIn)}
      </button>
      <p class="form-note">{lang === "vi" ? "Liên hệ hỗ trợ để kích hoạt quyền truy cập thành viên." : "Contact support to activate member access."}</p>
    </form>
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Tài nguyên thành viên" : "Member resources"}</p>
      <h2>{lang === "vi" ? <>Thông tin cho <em>khách hàng</em> và nhà phân phối.</> : <>Information for <em>customers</em> and distributors.</>}</h2>
      <div class="feature-grid">
        <article class="feature">
          <ShieldCheck size={24} aria-hidden="true" />
          <h3>{lang === "vi" ? "Hồ sơ và đơn hàng" : "Profiles and orders"}</h3>
          <p>{lang === "vi" ? "Thông tin thành viên, Sleepm ID, đơn hàng và hỗ trợ liên quan." : "Member details, Sleepm ID, orders and related support."}</p>
        </article>
        <article class="feature">
          <ShieldCheck size={24} aria-hidden="true" />
          <h3>{lang === "vi" ? "Tài liệu sản phẩm" : "Product resources"}</h3>
          <p>{lang === "vi" ? "Tài liệu nệm, topper, gối, BioCrystal, bảo hành và ứng dụng." : "Mattress, topper, pillow, BioCrystal, warranty and app materials."}</p>
        </article>
      </div>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.nav.contact)}</a>
    </div>
  </section>
</SiteLayout>
