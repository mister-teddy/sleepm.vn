---
import { ArrowLeft, BadgeCheck, Gem, Leaf, Sparkles } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, products, tx, type Lang, type Product } from "@data/site";

export function getStaticPaths() {
  return langCodes.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, slug: product.slug },
      props: { product },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const { product } = Astro.props as { product: Product };
---

<SiteLayout lang={lang} title={tx(lang, product.name)} description={tx(lang, product.summary)}>
  <LocalizedHero
    eyebrow={tx(lang, product.eyebrow)}
    title={tx(lang, product.title)}
    accent={lang === "vi" ? "" : product.slug === "mattress" ? "was waiting for" : ""}
    text={tx(lang, product.summary)}
    image={product.image}
    imageAlt={tx(lang, product.name)}
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/contact/")}>
        <Sparkles size={16} aria-hidden="true" />
        {tx(lang, common.labels.askFamily)}
      </a>
      <a class="text-link" href={pathFor(lang, "/products/")}>
        <ArrowLeft size={15} aria-hidden="true" />
        {tx(lang, common.labels.backCollection)}
      </a>
    </div>
  </LocalizedHero>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Bên trong" : "What's inside"}</p>
      <h2>{lang === "vi" ? <>Các lớp <em>êm dịu</em>.</> : <>Layers of <em>quiet</em> magic.</>}</h2>
      {tx(lang, product.details).map((line) => <p>{line}</p>)}
      <div class="cert-row" aria-label="Certifications">
        <img src="/images/certs/greenguard-gold.png" alt="GREENGUARD Gold" loading="lazy" />
        <img src="/images/certs/certipur.svg" alt="CertiPUR-US" loading="lazy" />
        <img src="/images/certs/repreve.svg" alt="Repreve" loading="lazy" />
        <img src="/images/certs/eco-inst.svg" alt="Eco Institut" loading="lazy" />
      </div>
    </div>
    <div class="product-frame awaken">
      <img src={product.gallery[1] ?? product.image} alt={tx(lang, product.name)} loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Chi tiết" : "Details"}</p>
      <h2>{lang === "vi" ? <>Điều làm nên <em>cảm giác</em>.</> : <>What makes the <em>feeling</em>.</>}</h2>
    </div>
    <div class="feature-grid">
      {product.features.map((feature, index) => (
        <article class="feature awaken">
          {index === 0 ? <BadgeCheck size={24} aria-hidden="true" /> : index === 1 ? <Leaf size={24} aria-hidden="true" /> : <Gem size={24} aria-hidden="true" />}
          <h3>{tx(lang, feature.title)}</h3>
          <p>{tx(lang, feature.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="product-frame awaken">
      <img src={product.gallery[0]} alt={tx(lang, product.name)} loading="lazy" />
    </div>
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Thông số" : "Specifications"}</p>
      <h2>{lang === "vi" ? <>Một cái nhìn <em>rõ ràng</em>.</> : <>A clearer <em>look</em>.</>}</h2>
      <dl class="spec-list">
        {product.specs.map((spec) => (
          <div>
            <dt>{tx(lang, spec.label)}</dt>
            <dd>{tx(lang, spec.value)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
