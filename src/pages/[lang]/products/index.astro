---
import { ArrowRight, MessageCircle } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, products, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.labels.collection)}>
  <LocalizedHero
    eyebrow={lang === "vi" ? "Dòng sản phẩm Sleepm" : "Sleepm product line"}
    title={lang === "vi" ? "Mattress, toppers, pillows, mini BioCrystal pad và eye mask." : "Mattress, toppers, pillows, mini BioCrystal pad and eye mask."}
    accent={lang === "vi" ? "wellness" : "wellness"}
    text={lang === "vi" ? "Danh sách này bám theo các trang sản phẩm người dùng nhìn thấy trong WordPress backup: Sleepm Mattress, Sleepm Toppers, Sleepm Pillows, Sleepm Mini Biocrystal Pad và Sleepm Eye Mask." : "This list follows the visible product pages in the WordPress backup: Sleepm Mattress, Sleepm Toppers, Sleepm Pillows, Sleepm Mini Biocrystal Pad and Sleepm Eye Mask."}
  />

  <section class="section section-wide">
    <div class="door-grid">
      {products.map((product) => (
        <a class="door awaken" href={pathFor(lang, `/products/${product.slug}/`)}>
          <img src={product.image} alt={tx(lang, product.name)} loading="lazy" />
          <div class="door-body">
            <span class="meta">{tx(lang, product.eyebrow)}</span>
            <h2>{tx(lang, product.name)}</h2>
            <p>{tx(lang, product.collectionLine)}</p>
            <span class="text-link">{tx(lang, common.labels.enter)} <ArrowRight size={15} aria-hidden="true" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Vật liệu và chứng nhận" : "Materials and certifications"}</p>
      <h2>{lang === "vi" ? <>Công nghệ BioCrystal cùng <em>vật liệu trong backup</em>.</> : <>BioCrystal technology with <em>backup product materials</em>.</>}</h2>
      <p>{lang === "vi" ? "Backup nhắc đến 16 loại pha lê sinh học phối hợp bạc và vàng, Cool Gel Memory Foam, cao su thiên nhiên Thái Lan, than hoạt tính và micro-coil trong các trang sản phẩm chính." : "The backup references 16 BioCrystal types with silver and gold, Cool Gel Memory Foam, Thai natural latex, activated carbon and micro-coils across the core product pages."}</p>
      <a class="btn" href={pathFor(lang, "/contact/")}>
        <MessageCircle size={16} aria-hidden="true" />
        {tx(lang, common.labels.askFamily)}
      </a>
    </div>
    <div class="card-grid">
      {[
        { metric: "16", label: { en: "BioCrystal types referenced in the backup", vi: "loại pha lê sinh học được backup nhắc đến" } },
        { metric: "2", label: { en: "metals: silver and gold", vi: "kim loại: bạc và vàng" } },
        { metric: "Info", label: { en: "no prices, cart or checkout on sleepm.vn", vi: "không giá bán, giỏ hàng hoặc thanh toán trên sleepm.vn" } },
      ].map((stat) => (
        <article class="stat-card awaken">
          <h2>{stat.metric}</h2>
          <p>{tx(lang, stat.label)}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
