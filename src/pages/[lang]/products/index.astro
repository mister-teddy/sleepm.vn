---
import { ArrowRight, Sparkles } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, products, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.labels.collection)}>
  <LocalizedHero
    eyebrow={lang === "vi" ? "Chín lối vào" : "Nine doors"}
    title={lang === "vi" ? "Chọn cách bạn bước vào đêm." : "Choose your way into the night."}
    accent={lang === "vi" ? "đêm" : "night"}
    text={lang === "vi" ? "Nệm, topper, gối, hơi ấm, ánh sáng và ứng dụng - mọi thứ được thiết kế quanh một nghi thức nghỉ ngơi yên tĩnh." : "Mattress, topper, pillows, warmth, light and app - the whole sleep ritual gathered into one collection."}
  />

  <section class="section section-wide">
    <div class="door-grid">
      {products.map((product) => (
        <a class="door awaken" href={pathFor(lang, `/products/${product.slug}/`)}>
          <img src={product.image} alt={tx(lang, product.name)} loading="lazy" />
          <div class="door-body">
            <span class="meta">{tx(lang, product.eyebrow)}</span>
            <h2>{tx(lang, product.name)}</h2>
            <p>{tx(lang, product.collectionLine)}</p>
            <span class="text-link">{tx(lang, common.labels.enter)} <ArrowRight size={15} aria-hidden="true" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Được chứng nhận và chăm chút" : "Crafted and certified"}</p>
      <h2>{lang === "vi" ? <>Vật liệu tốt. <em>Nghỉ ngơi sâu.</em></> : <>Premium materials. <em>Proven craft.</em></>}</h2>
      <p>{lang === "vi" ? "Các sản phẩm chủ lực của Sleepm kết hợp vật liệu sạch, công nghệ làm mát, lớp nâng đỡ và câu chuyện BioCrystal trong một trải nghiệm được chia sẻ trực tiếp." : "Sleepm's core products combine clean materials, cooling technology, support layers and the BioCrystal story in a person-to-person experience."}</p>
      <a class="btn" href={pathFor(lang, "/contact/")}>
        <Sparkles size={16} aria-hidden="true" />
        {tx(lang, common.labels.askFamily)}
      </a>
    </div>
    <div class="card-grid">
      {[
        { metric: "16", label: { en: "crystals in the BioCrystal blend", vi: "tinh thể trong hỗn hợp BioCrystal" } },
        { metric: "2", label: { en: "noble metals: gold and silver", vi: "kim loại quý: vàng và bạc" } },
        { metric: "0", label: { en: "store shelves - Sleepm travels hand to hand", vi: "kệ bán đại trà - Sleepm được trao tận tay" } },
      ].map((stat) => (
        <article class="stat-card awaken">
          <h2>{stat.metric}</h2>
          <p>{tx(lang, stat.label)}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
