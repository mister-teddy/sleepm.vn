---
import { Globe, HeartHandshake } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { advisors, common, family, langCodes, pathFor, people, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={tx(lang, common.nav.family)}>
  <LocalizedHero
    eyebrow={tx(lang, family.hero.eyebrow)}
    title={tx(lang, family.hero.title)}
    accent={tx(lang, { en: "BioCrystal", vi: "BioCrystal" })}
    text={tx(lang, family.hero.text)}
    image="/images/people/team.webp"
    imageAlt="Sleepm team"
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/distributors/")}>
        <HeartHandshake size={16} aria-hidden="true" />
        {tx(lang, common.labels.becomeDistributor)}
      </a>
      <a class="text-link" href={pathFor(lang, "/contact/")}>{tx(lang, common.labels.askFamily)}</a>
    </div>
  </LocalizedHero>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Cách SleepM được giới thiệu" : "How SleepM is presented"}</p>
      <h2>{lang === "vi" ? <>Sản phẩm, sản xuất và <em>thông tin</em>.</> : <>Product, manufacturing and <em>information</em>.</>}</h2>
    </div>
    <div class="timeline">
      {family.chapters.map((chapter) => (
        <article class="awaken">
          <strong>{chapter.year}</strong>
          <div>
            <h3>{tx(lang, chapter.title)}</h3>
            <p>{tx(lang, chapter.text)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Ban lãnh đạo" : "Leadership"}</p>
      <h2>{lang === "vi" ? <>Đội ngũ điều hành <em>Sleepm</em>.</> : <>The Sleepm <em>leadership</em> team.</>}</h2>
    </div>
    <div class="people-grid">
      {people.map((person) => (
        <article class="person awaken">
          <figure><img src={person.img} alt={person.name} loading="lazy" /></figure>
          <div class="person-body">
            <span class="meta">{tx(lang, person.role)}</span>
            <h3>{person.name}</h3>
            <p>{tx(lang, person.bio)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Cố vấn sức khỏe" : "Health and wellness advisors"}</p>
      <h2>{lang === "vi" ? <>Cố vấn wellness và <em>giấc ngủ</em>.</> : <>Wellness and <em>sleep</em> advisors.</>}</h2>
    </div>
    <div class="people-grid">
      {advisors.map((person) => (
        <article class="person awaken">
          <figure><img src={person.img} alt={person.name} loading="lazy" /></figure>
          <div class="person-body">
            <span class="meta">{tx(lang, person.role)}</span>
            <h3>{person.name}</h3>
            <p>{tx(lang, person.bio)}</p>
          </div>
        </article>
      ))}
      <article class="card awaken">
        <Globe size={24} aria-hidden="true" />
        <span class="meta">{lang === "vi" ? "Ba châu lục" : "Three continents"}</span>
        <h3>{lang === "vi" ? "Kênh toàn cầu" : "Global channels"}</h3>
        <p>{lang === "vi" ? "Thông tin chính thức về sản phẩm, bảo hành và hỗ trợ cần được đối chiếu qua kênh toàn cầu của SleepM." : "Official product, warranty and support information should be checked through SleepM global channels."}</p>
      </article>
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
