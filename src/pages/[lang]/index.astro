---
import { ArrowRight, Gem, HeartHandshake, Package } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, products, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const hero = {
  eyebrow: { en: "Sleepm BioCrystal Mattress", vi: "Sleepm BioCrystal Mattress" },
  title: {
    en: "Premium natural mattress with 16 BioCrystal types, gold and silver.",
    vi: "Nệm thủ công hữu cơ tự nhiên cao cấp với công nghệ 16 loại Pha Lê Sinh Học, bạc và vàng.",
  },
  accent: { en: "BioCrystal", vi: "Pha Lê Sinh Học" },
  text: {
    en: "SleepM presents a sleep wellness product line made with premium materials in the United States and Canada, centered on the BioCrystal insert described in the restored WordPress backup.",
    vi: "Hãy cùng trải nghiệm giấc ngủ ngon với nệm pha lê sinh học SleepM. Nội dung backup giới thiệu sản phẩm được thiết kế và sản xuất bằng vật liệu chất lượng cao tại Hoa Kỳ và Canada.",
  },
};

const featured = products.slice(0, 6);
---

<SiteLayout lang={lang} title={tx(lang, common.nav.home)}>
  <LocalizedHero
    eyebrow={tx(lang, hero.eyebrow)}
    title={tx(lang, hero.title)}
    accent={tx(lang, hero.accent)}
    text={tx(lang, hero.text)}
    image="/images/wp/mattress-room.png"
    imageAlt="Sleepm BioCrystal Mattress"
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/products/")}>
        <Package size={16} aria-hidden="true" />
        {tx(lang, common.labels.exploreCollection)}
      </a>
      <a class="text-link" href={pathFor(lang, "/crystals/")}>{tx(lang, common.nav.crystals)} <ArrowRight size={15} aria-hidden="true" /></a>
    </div>
  </LocalizedHero>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{tx(lang, common.labels.collection)}</p>
      <h2>{lang === "vi" ? <>Dòng sản phẩm <em>BioCrystal</em> từ backup WordPress.</> : <>The <em>BioCrystal</em> product line from the WordPress backup.</>}</h2>
    </div>
    <div class="product-rows">
      {featured.map((product) => (
        <a class="product-row awaken" href={pathFor(lang, `/products/${product.slug}/`)}>
          <h3>{tx(lang, product.name)}</h3>
          <p>{tx(lang, product.collectionLine)}</p>
          <ArrowRight size={22} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <section class="section section-wide split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Công nghệ BioCrystal" : "BioCrystal technology"}</p>
      <h2>{lang === "vi" ? <>Mười sáu loại pha lê cùng <em>bạc và vàng</em>.</> : <>Sixteen crystal types with <em>silver and gold</em>.</>}</h2>
      <p>{lang === "vi" ? "Backup mô tả BioCrystal là hỗn hợp 16 loại pha lê cổ xưa được khuếch đại bởi bạc và vàng, dùng trong nệm, topper, gối, đệm cá nhân và mặt nạ mắt." : "The backup describes BioCrystal as a mixture of 16 ancient crystal types amplified by silver and gold, used across mattresses, toppers, pillows, pads and the eye mask."}</p>
      <div class="actions">
        <a class="btn" href={pathFor(lang, "/crystals/")}>
          <Gem size={16} aria-hidden="true" />
          {lang === "vi" ? "Xem thành phần BioCrystal" : "View BioCrystal ingredients"}
        </a>
      </div>
    </div>
    <div class="crystal-strip awaken" aria-label="BioCrystal highlights">
      {["amethyst", "rose-quartz", "quartz", "citrine"].map((name) => (
        <img src={`/images/crystals/${name}.webp`} alt="" loading="lazy" />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{tx(lang, common.nav.nightWire)}</p>
      <h2>{lang === "vi" ? <>Thông tin sản phẩm và <em>hỗ trợ</em>.</> : <>Product information and <em>support</em>.</>}</h2>
    </div>
    <div class="card-grid">
      {[
        { title: { en: "Made in USA and Canada", vi: "Sản xuất tại Mỹ và Canada" }, text: { en: "The restored homepage states that SleepM mattresses are designed and produced with high-quality materials in the United States and Canada.", vi: "Homepage backup nêu nệm SleepM được thiết kế và sản xuất bằng vật liệu chất lượng cao tại Hoa Kỳ và Canada." } },
        { title: { en: "BioCrystal ingredient story", vi: "Câu chuyện BioCrystal" }, text: { en: "Sixteen crystal types are combined with silver and gold across the product line.", vi: "16 loại pha lê sinh học phối hợp với bạc và vàng trong dòng sản phẩm SleepM." } },
        { title: { en: "Information website", vi: "Website thông tin" }, text: { en: "sleepm.vn keeps product and contact information visible without cart, checkout or local payment processing.", vi: "sleepm.vn giữ thông tin sản phẩm và liên hệ, không có giỏ hàng, checkout hoặc thanh toán nội địa." } },
      ].map((item) => (
        <article class="card awaken">
          <span class="meta">{lang === "vi" ? "Sleepm" : "Sleepm"}</span>
          <h3>{tx(lang, item.title)}</h3>
          <p>{tx(lang, item.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="team-photo awaken">
      <img src="/images/wp/premium-quality.jpg" alt="SleepM premium quality visual from the WordPress backup" loading="lazy" />
    </div>
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Về sleepm.vn" : "About sleepm.vn"}</p>
      <h2>{lang === "vi" ? <>Minh bạch về <em>vai trò</em> website.</> : <>Clear about the website's <em>role</em>.</>}</h2>
      <p>{lang === "vi" ? "Trang này lấy nội dung nhìn thấy từ WordPress backup, nhưng vận hành sleepm.vn như website thông tin tiếng Việt về SleepM Global Inc., không phải cửa hàng TMĐT tại Việt Nam." : "This page uses visible content from the WordPress backup while operating sleepm.vn as a Vietnamese information website about SleepM Global Inc., not a Vietnam ecommerce store."}</p>
      <div class="actions">
        <a class="btn" href={pathFor(lang, "/terms/")}>
          <HeartHandshake size={16} aria-hidden="true" />
          {tx(lang, common.labels.becomeDistributor)}
        </a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
