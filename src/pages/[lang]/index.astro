---
import { ArrowRight, Gem, HeartHandshake, Sparkles } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, products, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const hero = {
  eyebrow: { en: "Luxury sleep, shared person to person", vi: "Giấc ngủ sang trọng, trao tận tay" },
  title: { en: "The most rested place on earth.", vi: "Nơi an yên nhất trên trái đất." },
  accent: { en: "rested", vi: "an yên" },
  text: {
    en: "Sixteen crystals, two noble metals, one extraordinary bed - never sold in stores. Sleepm is shared by the people who sleep on it.",
    vi: "Mười sáu tinh thể, hai kim loại quý, một chiếc giường khác biệt - không bán đại trà tại cửa hàng. Sleepm được chia sẻ bởi chính những người đang ngủ trên đó.",
  },
};

const featured = products.slice(0, 6);
---

<SiteLayout lang={lang} title={tx(lang, common.nav.home)}>
  <LocalizedHero
    eyebrow={tx(lang, hero.eyebrow)}
    title={tx(lang, hero.title)}
    accent={tx(lang, hero.accent)}
    text={tx(lang, hero.text)}
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/products/")}>
        <Sparkles size={16} aria-hidden="true" />
        {tx(lang, common.labels.exploreCollection)}
      </a>
      <a class="text-link" href={pathFor(lang, "/distributors/")}>{tx(lang, common.labels.becomeDistributor)} <ArrowRight size={15} aria-hidden="true" /></a>
    </div>
    <div class="bed-visual" aria-hidden="true">
      <span class="pillow"></span>
      <span class="glowline"></span>
      <span class="base"></span>
    </div>
  </LocalizedHero>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{tx(lang, common.labels.collection)}</p>
      <h2>{lang === "vi" ? <>Mọi thứ đêm ngủ <em>cần</em>.</> : <>Everything the night <em>needs</em>.</>}</h2>
    </div>
    <div class="product-rows">
      {featured.map((product) => (
        <a class="product-row awaken" href={pathFor(lang, `/products/${product.slug}/`)}>
          <h3>{tx(lang, product.name)}</h3>
          <p>{tx(lang, product.collectionLine)}</p>
          <ArrowRight size={22} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <section class="section section-wide split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Bên trong điều kỳ diệu" : "The magic inside"}</p>
      <h2>{lang === "vi" ? <>Mười sáu tinh thể. <em>Hai</em> kim loại quý.</> : <>Sixteen crystals. <em>Two</em> noble metals.</>}</h2>
      <p>{lang === "vi" ? "Được cân bằng bởi vàng và bạc, lớp BioCrystal là câu chuyện trung tâm trong mỗi sản phẩm Sleepm." : "Balanced by gold and silver, the BioCrystal layer is the central story inside every Sleepm product."}</p>
      <div class="actions">
        <a class="btn" href={pathFor(lang, "/crystals/")}>
          <Gem size={16} aria-hidden="true" />
          {lang === "vi" ? "Đi qua hành trình tinh thể" : "Walk the crystal journey"}
        </a>
      </div>
    </div>
    <div class="crystal-strip awaken" aria-label="BioCrystal highlights">
      {["amethyst", "rose-quartz", "quartz", "citrine"].map((name) => (
        <img src={`/images/crystals/${name}.webp`} alt="" loading="lazy" />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{tx(lang, common.nav.nightWire)}</p>
      <h2>{lang === "vi" ? <>Điều thế giới đang học về <em>giấc ngủ</em>.</> : <>What the world is learning about <em>sleep</em>.</>}</h2>
    </div>
    <div class="card-grid">
      {[
        { title: { en: "Body clocks shape mornings", vi: "Đồng hồ sinh học định hình buổi sáng" }, text: { en: "Circadian research keeps connecting sleep, metabolism and daylight.", vi: "Nghiên cứu nhịp sinh học tiếp tục kết nối giấc ngủ, chuyển hóa và ánh sáng ngày." } },
        { title: { en: "Bedroom sound gets quieter", vi: "Âm thanh phòng ngủ dịu hơn" }, text: { en: "Green noise and softer soundscapes are joining bedtime routines.", vi: "Green noise và không gian âm thanh mềm hơn đang đi vào thói quen trước ngủ." } },
        { title: { en: "Sleep tech grows up", vi: "Công nghệ giấc ngủ trưởng thành" }, text: { en: "Devices are learning to measure stillness, not just steps.", vi: "Thiết bị đang học cách đo sự tĩnh lại, không chỉ số bước chân." } },
      ].map((item) => (
        <article class="card awaken">
          <span class="meta">{lang === "vi" ? "Bản tin đêm" : "Night desk"}</span>
          <h3>{tx(lang, item.title)}</h3>
          <p>{tx(lang, item.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="team-photo awaken">
      <img src="/images/people/team.webp" alt="Sleepm family gathering" loading="lazy" />
    </div>
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Gia đình" : "The family"}</p>
      <h2>{lang === "vi" ? <>Đêm thuộc về <em>cộng đồng</em>.</> : <>The night belongs to the <em>family</em>.</>}</h2>
      <p>{lang === "vi" ? "Từ người mới bắt đầu đến các nhà phân phối tám sao, Sleepm được mang đi bằng niềm tin vào những đêm ngủ tốt hơn." : "From first-star newcomers to eight-star distributors, Sleepm is carried hand to hand by people who believe in better sleep."}</p>
      <div class="actions">
        <a class="btn" href={pathFor(lang, "/family/")}>
          <HeartHandshake size={16} aria-hidden="true" />
          {tx(lang, common.nav.family)}
        </a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
