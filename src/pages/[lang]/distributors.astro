---
import { CircleCheck, ExternalLink, MessageCircle, ShieldCheck } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const requirements = [
  {
    title: { en: "Keep sleepm.vn as brand protection", vi: "Gia hạn sleepm.vn để bảo vệ thương hiệu" },
    text: {
      en: "Renewing the domain protects the brand asset. Domain renewal is separate from using the website for local ecommerce.",
      vi: "Gia hạn tên miền giúp bảo vệ tài sản thương hiệu. Việc gia hạn tên miền tách biệt với việc dùng website để kinh doanh TMĐT nội địa.",
    },
  },
  {
    title: { en: "Information portal first", vi: "Ưu tiên cổng thông tin" },
    text: {
      en: "The current direction is: SleepM introduction, technology, products, research, FAQ, contact and links to sleepm.com.",
      vi: "Định hướng hiện tại: Giới thiệu SleepM, công nghệ, sản phẩm, nghiên cứu, FAQ, liên hệ và đường dẫn đến sleepm.com.",
    },
  },
  {
    title: { en: "No separate SleepM Vietnam entity claim", vi: "Không tự nhận có Công ty SleepM Việt Nam" },
    text: {
      en: "The site identifies SleepM Global Inc. and does not imply a separate Vietnam legal entity unless one exists.",
      vi: "Website nêu rõ SleepM Global Inc. và không tạo cách hiểu có pháp nhân SleepM Việt Nam riêng nếu chưa tồn tại.",
    },
  },
  {
    title: { en: "No Vietnam office claim without legal basis", vi: "Không công bố văn phòng Việt Nam nếu chưa có căn cứ" },
    text: {
      en: "No Vietnam address is described as an official SleepM Global Inc. office unless the legal basis is established.",
      vi: "Không mô tả địa chỉ tại Việt Nam là văn phòng chính thức của SleepM Global Inc. nếu chưa có căn cứ pháp lý tương ứng.",
    },
  },
  {
    title: { en: "No local ecommerce flow", vi: "Không biến thành website bán hàng nội địa" },
    text: {
      en: "No direct order, cart, checkout, quote, payment, order confirmation or transaction conclusion is provided on sleepm.vn.",
      vi: "Không có đặt hàng trực tiếp, giỏ hàng, thanh toán, chào giá, xác nhận đơn hàng hoặc giao kết giao dịch trên sleepm.vn.",
    },
  },
  {
    title: { en: "Careful contact wording", vi: "Thận trọng với phần liên hệ" },
    text: {
      en: "Vietnamese information contacts are described by their actual role and not as legal representatives or official Vietnam offices.",
      vi: "Đầu mối thông tin tiếng Việt được mô tả đúng vai trò thực tế, không gọi là đại diện pháp lý hoặc văn phòng chính thức tại Việt Nam.",
    },
  },
];
---

<SiteLayout lang={lang} title={tx(lang, common.nav.distributors)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Legal and operating FAQ", vi: "FAQ pháp lý và vận hành" })}
    title={tx(lang, { en: "sleepm.vn is an information website, not a Vietnam ecommerce store.", vi: "sleepm.vn là website thông tin, không phải cửa hàng TMĐT tại Việt Nam." })}
    accent={tx(lang, { en: "information", vi: "thông tin" })}
    text={tx(lang, { en: "This page records the content rules that should not be wrong: legal role, contact language, ecommerce limits and official global channels.", vi: "Trang này ghi lại các nguyên tắc nội dung không thể sai: vai trò pháp lý, cách ghi liên hệ, giới hạn TMĐT và kênh toàn cầu chính thức." })}
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/contact/")}>
        <MessageCircle size={16} aria-hidden="true" />
        {tx(lang, common.labels.askFamily)}
      </a>
      <a class="text-link" href="https://sleepm.com/" target="_blank" rel="noopener">
        sleepm.com <ExternalLink size={15} aria-hidden="true" />
      </a>
    </div>
  </LocalizedHero>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Nguyên tắc nội dung" : "Content rules"}</p>
      <h2>{lang === "vi" ? <>Các điểm cần <em>giữ đúng</em>.</> : <>Points that must stay <em>accurate</em>.</>}</h2>
    </div>
    <div class="card-grid">
      {requirements.map((reason) => (
        <article class="feature awaken">
          <CircleCheck size={24} aria-hidden="true" />
          <h3>{tx(lang, reason.title)}</h3>
          <p>{tx(lang, reason.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Căn cứ hiện hành" : "Current reference"}</p>
      <h2>{lang === "vi" ? <>Luật TMĐT có hiệu lực từ <em>01/07/2026</em>.</> : <>Vietnam ecommerce rules effective <em>July 1, 2026</em>.</>}</h2>
      <p>
        {lang === "vi"
          ? "Luật Thương mại điện tử 122/2025/QH15 và Nghị định 248/2026/NĐ-CP đều có hiệu lực từ 01/07/2026. Trước khi thêm bất kỳ chức năng giao dịch nào, cần xác định rõ chủ thể bán hàng và nghĩa vụ liên quan."
          : "Vietnam Ecommerce Law 122/2025/QH15 and Decree 248/2026/ND-CP are both effective July 1, 2026. Before adding any transaction feature, the seller and related obligations must be clearly identified."}
      </p>
      <p class="meta">{lang === "vi" ? "Nội dung này là ghi chú vận hành website, không thay thế tư vấn pháp lý." : "This is website operating guidance, not legal advice."}</p>
    </div>
    <div class="card-grid">
      {[
        { metric: "122/2025/QH15", label: { en: "Vietnam Ecommerce Law", vi: "Luật Thương mại điện tử" } },
        { metric: "248/2026/NĐ-CP", label: { en: "Implementing decree", vi: "Nghị định quy định chi tiết" } },
        { metric: "01/07/2026", label: { en: "Effective date", vi: "Ngày có hiệu lực" } },
      ].map((item) => (
        <article class="stat-card awaken">
          <ShieldCheck size={24} aria-hidden="true" />
          <h2>{item.metric}</h2>
          <p>{tx(lang, item.label)}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
