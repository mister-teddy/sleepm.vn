---
import { CircleCheck, MessageCircle, Star } from "@lucide/astro";
import CtaBand from "@components/CtaBand.astro";
import LocalizedHero from "@components/LocalizedHero.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { common, langCodes, pathFor, tx, type Lang } from "@data/site";

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const reasons = [
  { title: { en: "Product-first conversations", vi: "Tư vấn dựa trên sản phẩm" }, text: { en: "Distributors introduce mattresses, toppers, pillows and accessories with clear material and feature information.", vi: "Nhà phân phối giới thiệu nệm, topper, gối và phụ kiện bằng thông tin vật liệu và tính năng rõ ràng." } },
  { title: { en: "Local office support", vi: "Hỗ trợ từ văn phòng địa phương" }, text: { en: "Showrooms and offices can support product education, appointments and customer follow-up.", vi: "Showroom và văn phòng hỗ trợ giới thiệu sản phẩm, đặt lịch và chăm sóc khách hàng." } },
  { title: { en: "Multilingual markets", vi: "Thị trường đa ngôn ngữ" }, text: { en: "English, Vietnamese and other communities can receive product information in their own language.", vi: "Cộng đồng tiếng Anh, tiếng Việt và các ngôn ngữ khác có thể tiếp cận thông tin sản phẩm bằng ngôn ngữ của mình." } },
  { title: { en: "Clear compliance", vi: "Minh bạch và đúng chuẩn" }, text: { en: "Distributor activity should follow current Sleepm policies and never promise medical or income outcomes.", vi: "Hoạt động phân phối cần theo chính sách Sleepm hiện hành và không hứa hẹn kết quả y tế hoặc thu nhập." } },
];
---

<SiteLayout lang={lang} title={tx(lang, common.nav.distributors)}>
  <LocalizedHero
    eyebrow={tx(lang, { en: "Become a distributor", vi: "Trở thành nhà phân phối" })}
    title={tx(lang, { en: "Introduce Sleepm products in your local market.", vi: "Giới thiệu sản phẩm Sleepm tại thị trường của bạn." })}
    accent={tx(lang, { en: "local", vi: "thị trường" })}
    text={tx(lang, { en: "Sleepm uses a distributor model supported by product education, office contacts and local appointments.", vi: "Sleepm dùng mô hình nhà phân phối với hỗ trợ đào tạo sản phẩm, kênh văn phòng và lịch hẹn tại địa phương." })}
  >
    <div class="actions">
      <a class="btn" href={pathFor(lang, "/contact/")}>
        <MessageCircle size={16} aria-hidden="true" />
        {tx(lang, { en: "Start the conversation", vi: "Bắt đầu trò chuyện" })}
      </a>
      <a class="text-link" href={pathFor(lang, "/products/")}>{tx(lang, { en: "See what you would share", vi: "Xem điều bạn sẽ chia sẻ" })}</a>
    </div>
  </LocalizedHero>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Vai trò nhà phân phối" : "Distributor role"}</p>
      <h2>{lang === "vi" ? <>Tập trung vào <em>sản phẩm</em> và khách hàng.</> : <>Focused on <em>products</em> and customers.</>}</h2>
    </div>
    <div class="card-grid">
      {reasons.map((reason) => (
        <article class="feature awaken">
          <CircleCheck size={24} aria-hidden="true" />
          <h3>{tx(lang, reason.title)}</h3>
          <p>{tx(lang, reason.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section split">
    <div class="copy-block awaken">
      <p class="eyebrow">{lang === "vi" ? "Cấp bậc ghi nhận" : "Recognition levels"}</p>
      <h2>{lang === "vi" ? <>Từ cấp đầu tiên đến <em>8 sao</em>.</> : <>From first level to <em>8-star</em>.</>}</h2>
      <p>{lang === "vi" ? "Các cấp sao thể hiện sự ghi nhận trong mạng lưới phân phối và đào tạo. Điều kiện cụ thể cần xác nhận theo chính sách Sleepm hiện hành." : "Star levels represent recognition in the distributor and training network. Requirements should be confirmed against current Sleepm policy."}</p>
      <p class="meta">{lang === "vi" ? "Không phải cam kết thu nhập hoặc kết quả kinh doanh." : "Not an income or business-result guarantee."}</p>
    </div>
    <div class="star-ladder awaken" aria-label="Eight star distributor path">
      {Array.from({ length: 8 }).map((_, index) => (
        <span>
          <Star size={24} aria-hidden="true" />
          {index + 1}
        </span>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head awaken">
      <p class="eyebrow">{lang === "vi" ? "Ba bước nhỏ" : "Three small steps"}</p>
      <h2>{lang === "vi" ? <>Cách bắt <em>đầu</em>.</> : <>How it <em>starts</em>.</>}</h2>
    </div>
    <div class="card-grid">
      {[
        { n: "I", title: { en: "Contact Sleepm", vi: "Liên hệ Sleepm" }, text: { en: "Send your market, language and product-interest details through the contact page.", vi: "Gửi thông tin thị trường, ngôn ngữ và sản phẩm bạn quan tâm qua trang liên hệ." } },
        { n: "II", title: { en: "Learn the product line", vi: "Tìm hiểu dòng sản phẩm" }, text: { en: "Review mattress, topper, pillow, accessory, warranty and app information.", vi: "Xem thông tin nệm, topper, gối, phụ kiện, bảo hành và ứng dụng." } },
        { n: "III", title: { en: "Confirm next steps", vi: "Xác nhận bước tiếp theo" }, text: { en: "Work with the relevant office or sponsor to understand current requirements.", vi: "Làm việc với văn phòng hoặc người bảo trợ phù hợp để hiểu điều kiện hiện hành." } },
      ].map((step) => (
        <article class="stat-card awaken">
          <span class="meta">{step.n}</span>
          <h3>{tx(lang, step.title)}</h3>
          <p>{tx(lang, step.text)}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</SiteLayout>
