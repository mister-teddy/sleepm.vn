---
export function getStaticPaths() {
  const redirects: Record<string, string> = {
    products: "/#san-pham",
    "crystal-journey": "/#cong-nghe",
    crystals: "/#cong-nghe",
    constellation: "/#cong-nghe",
    "night-wire": "/#nghien-cuu",
    family: "/#gioi-thieu",
    "become-a-distributor": "/#faq",
    distributors: "/#faq",
    "sign-in": "/#faq",
    contact: "/#lien-he",
    "sleep-health": "/#nghien-cuu",
    testimonials: "/#nghien-cuu",
    payments: "/#faq",
    warranty: "/#lien-he",
    privacy: "https://sleepm.com/privacy/",
    "terms-conditions": "https://sleepm.com/terms-conditions/",
  };

  return Object.entries(redirects).map(([slug, target]) => ({
    params: { slug },
    props: { target },
  }));
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Chuyển hướng - SleepM</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Đang chuyển hướng đến <a href={target}>nội dung SleepM phù hợp</a>.</p>
  </body>
</html>
