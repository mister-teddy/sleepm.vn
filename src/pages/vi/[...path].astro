---
export function getStaticPaths() {
  const targets = [
    ["products", "/#san-pham"],
    ["products/mattress", "/#san-pham"],
    ["products/topper", "/#san-pham"],
    ["products/pillows", "/#san-pham"],
    ["products/heating-pad", "/#san-pham"],
    ["products/eye-mask", "/#san-pham"],
    ["products/knee-massager", "/#san-pham"],
    ["products/light", "/#san-pham"],
    ["products/dot", "/#san-pham"],
    ["products/app", "/#san-pham"],
    ["crystals", "/#cong-nghe"],
    ["crystal-journey", "/#cong-nghe"],
    ["constellation", "/#cong-nghe"],
    ["night-wire", "/#nghien-cuu"],
    ["family", "/#gioi-thieu"],
    ["distributors", "/#faq"],
    ["become-a-distributor", "/#faq"],
    ["sign-in", "/#faq"],
    ["contact", "/#lien-he"],
  ];

  return targets.map(([path, target]) => ({
    params: { path },
    props: { target },
  }));
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Chuyển hướng - SleepM</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Đang chuyển hướng đến <a href={target}>nội dung SleepM phù hợp</a>.</p>
  </body>
</html>
